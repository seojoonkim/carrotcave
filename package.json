{
  "name": "rabbit-crypt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-voice-fonts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/verify-release-baseline.mjs --content-only && npm run audit:ontology && node scripts/prepare-voice-fonts.mjs",
    "release:check": "node scripts/verify-release-baseline.mjs",
    "test:voice-layout": "node scripts/verify-voice-layout.cjs",
    "release:production": "node scripts/release-production.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "publish:telegram": "node scripts/publish-single-message.mjs",
    "audit:telegram:daily": "node scripts/auto-sync.mjs --no-git",
    "sync:telegram:daily": "node scripts/auto-sync.mjs --no-git",
    "ontology:regen": "node scripts/build-ontology-index.mjs",
    "audit:post-titles": "node scripts/audit-post-titles.mjs",
    "audit:post-abstracts": "node scripts/audit-post-abstracts.mjs",
    "audit:ontology": "node scripts/audit-ontology.mjs",
    "audit:og-titles": "node scripts/og-title-fit.mts",
    "audit:og-image-text": "node scripts/og-image-hangul-audit.mjs",
    "verify": "npm test && npm run audit:og-titles && npm run audit:og-image-text && npm run audit:post-titles && npm run audit:post-abstracts && npm run audit:ontology && npm run build",
    "content-only-release-check": "node scripts/assert-content-only-release.mjs HEAD",
    "recategorize": "node scripts/recategorize-post.mjs",
    "postbuild": "node scripts/check-build-css-fresh.mjs",
    "i18n:translate": "python3 scripts/i18n/run-with-lb.py node scripts/i18n/translate-posts.mjs && python3 scripts/i18n/run-with-lb.py node scripts/i18n/translate-voices.mjs && node scripts/i18n/bundle-en.mjs --strict"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@vercel/blob": "^2.8.0",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
