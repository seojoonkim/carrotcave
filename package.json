{
  "name": "rabbit-crypt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-voice-fonts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-voice-fonts.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "publish:telegram": "node scripts/publish-single-message.mjs",
    "audit:telegram:daily": "node scripts/auto-sync.mjs --no-git",
    "audit:post-titles": "node scripts/audit-post-titles.mjs",
    "audit:post-abstracts": "node scripts/audit-post-abstracts.mjs",
    "audit:ontology": "node scripts/audit-ontology.mjs",
    "verify": "npm test && npm run audit:post-titles && npm run audit:post-abstracts && npm run audit:ontology && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
